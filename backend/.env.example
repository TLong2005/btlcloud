PORT=4000

DATABASE_URL=postgres://docmind:docmind@localhost:5432/docmind
# DB_SECRET_ARN=arn:aws:secretsmanager:ap-southeast-1:123456789012:secret:docmind/db
# DB_HOST=docmind.xxxx.ap-southeast-1.rds.amazonaws.com
# DB_PORT=5432
# DB_NAME=docmind

AWS_REGION=ap-southeast-1

JWT_SECRET=change-me
JWT_EXPIRES_IN=8h

# s3 | local   (local writes to ./.local-storage)
STORAGE_DRIVER=local
# S3_BUCKET=docmind-documents

# sqs | inmemory   (the worker consumes either SQS or the local queue)
QUEUE_DRIVER=inmemory
# SQS_QUEUE_URL=https://sqs.ap-southeast-1.amazonaws.com/123456789012/docmind-ingest

# bedrock | mock | openai
AI_DRIVER=mock
# BEDROCK_CHAT_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_EMBEDDING_MODEL_ID=cohere.embed-multilingual-v3

# OPENAI_SECRET_ARN=arn:aws:secretsmanager:ap-southeast-1:123456789012:secret:docmind/openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-6.1-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

SIMILARITY_THRESHOLD=0.3
DEMO_MODE=false
WORK_DIR=/tmp/docmind
MAX_UPLOAD_MB=10
MAX_RECEIVE_COUNT=3
WORKER_ARTIFICIAL_DELAY_MS=0
