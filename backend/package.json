{
  "name": "docmind-cloud",
  "version": "0.1.0",
  "private": true,
  "description": "DocMind Cloud multi-tenant document Q&A API",
  "scripts": {
    "build": "nest build && tsc -p tsconfig.scripts.json",
    "bulk-upload": "tsc -p tsconfig.scripts.json && node dist/scripts/bulk-upload.js",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "start:worker:dev": "nest start --watch --entryFile worker",
    "seed": "node dist/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1160.0",
    "@aws-sdk/client-s3": "^3.1160.0",
    "@aws-sdk/client-secrets-manager": "^3.1160.0",
    "@aws-sdk/client-sqs": "^3.1160.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.3.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@types/bcrypt": "^6.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "typescript": "^6.0.3"
  }
}
